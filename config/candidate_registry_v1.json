{
  "schema_version": "1.0",
  "name": "Jho Candidate Registry v1",
  "principles": {
    "unit_of_evaluation": "harness + access_path + model + variant_or_effort + role",
    "external_benchmarks_are": "priors_only",
    "local_metrics_are": "authoritative_over_time",
    "exploration": "allowed_for_eligible_candidates"
  },
  "hard_rules": [
    {
      "id": "RULE-001",
      "name": "Never use Astra",
      "match": {
        "harness": "codex",
        "model": "gpt-6-astra"
      },
      "action": "deny",
      "reason": "User policy: excellent model, but too expensive."
    },
    {
      "id": "RULE-002",
      "name": "Do not route GPT through OpenCode",
      "match": {
        "harness": "opencode",
        "model_family": "gpt"
      },
      "action": "deny",
      "reason": "GPT capacity is already available directly through Codex."
    },
    {
      "id": "RULE-003",
      "name": "NVIDIA is background-long only",
      "match": {
        "harness": "opencode",
        "access_path": "nvidia"
      },
      "action": "background_long_only",
      "reason": "Observed latency/restrictions make NVIDIA unsuitable for interactive routing."
    },
    {
      "id": "RULE-004",
      "name": "Variants are separate candidates",
      "action": "preserve_variants",
      "reason": "Different reasoning intensities are evaluated independently."
    },
    {
      "id": "RULE-005",
      "name": "Harness parity",
      "action": "uniform_logical_contract",
      "reason": "Codex, OpenCode and AGY must expose the same logical contract to Jho Lite: explicit candidate identity, unattended execution, policy decided before the run, live progress, timeout, telemetry and a terminal result."
    }
  ],
